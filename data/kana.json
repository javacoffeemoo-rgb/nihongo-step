{
  "lessons": {
    "kana_hiragana_1": {
      "title": "히라가나 ①",
      "groups": [
        {
          "label": "청음 ① あ행 ~ な행",
          "rows": [
            ["あ", "い", "う", "え", "お"],
            ["か", "き", "く", "け", "こ"],
            ["さ", "し", "す", "せ", "そ"],
            ["た", "ち", "つ", "て", "と"],
            ["な", "に", "ぬ", "ね", "の"]
          ]
        }
      ],
      "tip": "히라가나는 일본어의 기본 글자예요. 가로로 읽으면 あいうえお, 세로로 읽으면 あかさたな 순서예요."
    },
    "kana_hiragana_2": {
      "title": "히라가나 ②",
      "groups": [
        {
          "label": "청음 ② は행 ~ わ행",
          "rows": [
            ["は", "ひ", "ふ", "へ", "ほ"],
            ["ま", "み", "む", "め", "も"],
            ["や", "ゆ", "よ"],
            ["ら", "り", "る", "れ", "ろ"],
            ["わ", "を", "ん"]
